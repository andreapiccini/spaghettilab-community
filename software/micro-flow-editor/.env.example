# Copy this file to .env to override the defaults baked into compose.yaml.
# The dev server starts with sensible defaults even without a .env file.

# Host port the Vite dev server is published on (loopback only).
MICRO_FLOW_EDITOR_PORT=5173

# Visitor-only Processing Graph (English, no Core). Same as opening ?demo=1.
# Set this on the Vite app build (packages/app), not Compose.
# VITE_DEMO_ONLY=1
