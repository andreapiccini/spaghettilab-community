	(text "VPORT = 3.3V (VIN2, default) or 5V (VIN1) selected by ESP32 IO40 (VPORT_SEL, high = 5V). VPORT feeds the AO6604 P-MOS of all 16 ports and their 100k gate pull-ups."
		(exclude_from_sim no)
		(at 130.81 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "66cfde2d-ff35-4b21-83fc-eee372e9ba02")
	)
	(text "I2C level shifter: TCA9555 (U25, U73) now powered from 5V so they can switch the P-MOS gates with VPORT up to 5V."
		(exclude_from_sim no)
		(at 30.48 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7be766d8-af29-423c-b2db-ce044d35686e")
	)
	(text "Port protection (solution B): GPIO -> BAT54SDW clamp to VCORE/GND -> 330R -> PORT pin. Rule: no voltage above VPORT on any port pin. Firmware: set GPIO to hi-Z before turning a port to VCC/GND."
		(exclude_from_sim no)
		(at 30.48 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "86da22e5-fa9d-45d5-8a7b-5d0e473de1e1")
	)
