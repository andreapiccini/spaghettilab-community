	(text "Each package clamps two ESP GPIO lines to VCORE and GND."
		(exclude_from_sim no)
		(at 40 58 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "4c3187c7-eaa8-4ab5-9b84-3ed37b34f924")
	)
	(text "U903 / U902 | VPORT LIMIT + MONITOR"
		(exclude_from_sim no)
		(at 219 187 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "56bdf14d-8665-438a-a6f3-4f25aa48d887")
	)
	(text "VPORT = 3.3V (VIN2, default) or 5V (VIN1) selected by ESP32 IO40 (VPORT_SEL, high = 5V). VPORT feeds the AO6604 P-MOS of all 16 ports and their 100k gate pull-ups."
		(exclude_from_sim no)
		(at 130.81 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "66cfde2d-ff35-4b21-83fc-eee372e9ba02")
	)
	(text "I2C level shifter: TCA9555 (U25, U73) now powered from 5V so they can switch the P-MOS gates with VPORT up to 5V."
		(exclude_from_sim no)
		(at 40 212 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7be766d8-af29-423c-b2db-ce044d35686e")
	)
	(text "Port protection (solution B): GPIO -> BAT54SDW clamp to VCORE/GND -> 330R -> PORT pin. Rule: no voltage above VPORT on any port pin. Firmware: set GPIO to hi-Z before turning a port to VCC/GND."
		(exclude_from_sim no)
		(at 30.48 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "86da22e5-fa9d-45d5-8a7b-5d0e473de1e1")
	)
	(text "VPORT monitor: U902 INA226 @0x40 (A0=A1=GND) on I2C_CTRL. TPS2116 out = VPORT_MUX -> U903 SY6280 current limit ~1.9A (R907 3.6k, EN=IO34, R908 100k pull-up = on by default) -> VPORT_RAW -> shunt R905 50mR -> VPORT: 0.1V/0.2W @2A. VBUS reads VPORT (3.3V or 5V). ALERT (open drain) -> IO36 with R906 10k pull-up. Layout: Kelvin sense from R905 pads to VIN+/VIN-. Firmware: on INA alert turn ports off one by one; ignore first ms after port turn-on (inrush)."
		(exclude_from_sim no)
		(at 219 242 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a7c25a1d-f163-4f40-918f-b10111a1f7f5")
	)
	(text "RN901-RN904 | SERIES 330R (4x array)"
		(exclude_from_sim no)
		(at 40 93 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "ad303c47-58a4-4779-af9e-557c4c7d9331")
	)
	(text "GPIO -> 330R -> port pin. One symbol per physical array."
		(exclude_from_sim no)
		(at 40 98 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "b8fea59f-a436-49eb-b957-2310c3799f79")
	)
	(text "D921-D928 | GPIO CLAMP (BAT54SDW, SOT-363)"
		(exclude_from_sim no)
		(at 40 53 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "ba3b8dbe-ca68-4785-a1f3-b9de35edfc0e")
	)
	(text "U901 | VPORT SELECT 3.3 V / 5 V"
		(exclude_from_sim no)
		(at 130 200 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "c25b85c9-8c51-4ecb-979e-664dc330cb36")
	)
	(text "Q901 | I2C LEVEL SHIFTER"
		(exclude_from_sim no)
		(at 40 200 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "c79fc589-52b7-49a8-b487-6bbed0b2db3b")
	)
