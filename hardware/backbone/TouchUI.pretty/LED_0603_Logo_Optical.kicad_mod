(footprint "LED_0603_Logo_Optical"(version 20260206)(generator pcbnew)(layer "F.Cu")(descr "0603 prototype optical LED: hand assembly lens toward FR4, 1.2mm central copper-free gap. Validate on prototype.")(attr smd)
(fp_rect(start -1.25 -.5)(end 1.25 .5)(stroke(width .05)(type solid))(fill no)(layer "F.CrtYd"))
(fp_rect(start -.8 -.4)(end .8 .4)(stroke(width .1)(type solid))(fill no)(layer "F.Fab"))
(pad "1" smd roundrect(at -.9 0)(size .6 .74)(layers "F.Cu" "F.Mask" "F.Paste")(roundrect_rratio .2))
(pad "2" smd roundrect(at .9 0)(size .6 .74)(layers "F.Cu" "F.Mask" "F.Paste")(roundrect_rratio .2))




(model "${KIPRJMOD}/OpticalLED.3dshapes/LED0603_White.wrl"(offset(xyz 0 0 0))(scale(xyz 1 1 1))(rotate(xyz 0 0 0)))
)
