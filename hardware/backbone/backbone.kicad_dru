(version 1)
# =====================================================================
# Backbone 6 strati - regole JLCPCB (multistrato 4-6 layer), 2026-11-25
# Stackup: F.Cu | In1 GND | In2 SIG | In3 SIG | In4 PWR (5V/VCORE) | B.Cu
# Rame: esterni 1 oz (35 um), interni 0,5 oz (17,5 um) = default JLC.
# Limiti JLC (tabella capabilities): pista/spazio 0,09 mm; via min 0,45/0,20 mm
# (multistrato, senza sovrapprezzo); foro-foro reti diverse 0,5 mm, stessa rete 0,254 mm;
# via-pista 0,254 mm, PTH-pista 0,33 mm, NPTH-pista 0,254 mm (misurati dal foro);
# pad-pista 0,2 mm; pad-pad SMD 0,127 mm; pad-pad con foro 0,5 mm; pista-bordo 0,2 mm.
# Larghezze di corrente: IPC-2221, dT 10 C, +20% tolleranza incisione, arrotondate a 0,05 mm.
# Le regole di corrente sono WARNING (il DRC non conosce la corrente reale di ogni tratto);
# le regole JLC sono ERRORI.
# =====================================================================

# ---------- Limiti di fabbricazione JLC (errori) ----------
(rule "JLC via 0.45/0.20" (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.45mm)) (constraint hole_size (min 0.20mm)) (constraint annular_width (min 0.125mm)))
(rule "JLC hole to copper (via/NPTH)" (constraint hole_clearance (min 0.254mm)))
(rule "JLC PTH to track" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (B.Type == 'Track' || B.Type == 'Arc')")
  (constraint hole_clearance (min 0.33mm)))
(rule "JLC hole to hole same net" (constraint hole_to_hole (min 0.254mm)))
(rule "JLC hole to hole different nets" (condition "A.NetName != B.NetName") (constraint hole_to_hole (min 0.50mm)))
(rule "JLC pad to track" (condition "A.Type == 'Pad' && (B.Type == 'Track' || B.Type == 'Arc')") (constraint clearance (min 0.20mm)))
(rule "JLC SMD pad to pad" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'") (constraint clearance (min 0.127mm)))
(rule "JLC PTH pad to pad" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'") (constraint clearance (min 0.50mm)))
(rule "Standard low-cost through-via technology" (constraint disallow micro_via blind_via buried_via))

# ---------- Larghezze minime per corrente (warning) ----------
# 0,5 A per ramo porta: esterno 0,15 mm, interno (0,5 oz) 0,75 mm
(rule "Port branch 0.5A outer" (severity warning) (layer outer) (condition "A.hasNetclass('PORT_IO_POWER') && !A.intersectsCourtyard('*')") (constraint track_width (min 0.15mm)))
(rule "Port branch 0.5A inner" (severity warning) (layer inner) (condition "A.hasNetclass('PORT_IO_POWER') && !A.intersectsCourtyard('*')") (constraint track_width (min 0.75mm)))
# 2 A (VCORE, VPORT* dopo/prima del limitatore SY6280 ~1,9 A, 5V_EXP limitato ~1,9 A, BUCK_SW)
(rule "2A rails outer" (severity warning) (layer outer) (condition "(A.hasNetclass('POWER_3V3') || A.hasNetclass('POWER_VPORT') || A.hasNetclass('POWER_5V_EXP') || A.hasNetclass('BUCK_SWITCH')) && !A.intersectsCourtyard('*')") (constraint track_width (min 0.95mm)))
(rule "2A rails inner" (severity warning) (layer inner) (condition "(A.hasNetclass('POWER_3V3') || A.hasNetclass('POWER_VPORT') || A.hasNetclass('POWER_5V_EXP')) && !A.intersectsCourtyard('*')") (constraint track_width (min 4.90mm)))
# 3 A (5V dorsale e VBUS USB): sugli interni usare la zona In4, non piste
(rule "3A rails outer" (severity warning) (layer outer) (condition "(A.hasNetclass('POWER_5V') || A.hasNetclass('USB_VBUS')) && !A.intersectsCourtyard('*')") (constraint track_width (min 1.65mm)))
(rule "3A rails inner" (severity warning) (layer inner) (condition "(A.hasNetclass('POWER_5V') || A.hasNetclass('USB_VBUS')) && !A.intersectsCourtyard('*')") (constraint track_width (min 8.55mm)))
# Uscita dai pad: dentro il courtyard di un componente le alimentazioni possono stringersi (tratti corti)
(rule "Power neck-down inside courtyards" (condition "(A.hasNetclass('POWER_5V') || A.hasNetclass('USB_VBUS') || A.hasNetclass('POWER_5V_EXP') || A.hasNetclass('POWER_VPORT') || A.hasNetclass('POWER_3V3') || A.hasNetclass('PORT_IO_POWER') || A.hasNetclass('BUCK_SWITCH') || A.hasNetclass('GND')) && A.intersectsCourtyard('*')")
  (constraint track_width (min 0.10mm)))

# ---------- Coppie differenziali ----------
# USB full-speed: 0,15/0,15 su esterno con GND (In1) a 0,1 mm -> circa 90 ohm (stima IPC-2141, verificare con calcolatore JLC)
(rule "USB differential pair" (condition "A.hasNetclass('USB_DIFF')")
  (constraint track_width (min 0.13mm) (opt 0.15mm) (max 0.18mm))
  (constraint diff_pair_gap (min 0.13mm) (opt 0.15mm) (max 0.20mm))
  (constraint diff_pair_uncoupled (max 5mm)) (constraint skew (max 0.5mm)))
# CAN: 0,10/0,30 su esterno -> circa 120 ohm (stima); a 1 Mbit/s l'impedenza non e critica
(rule "CAN differential pair" (condition "A.hasNetclass('CAN_BUS') && A.NetName != '/TERM_R'")
  (constraint diff_pair_gap (min 0.15mm) (opt 0.30mm) (max 0.50mm))
  (constraint diff_pair_uncoupled (max 10mm)))

# ---------- Vincoli funzionali (invariati) ----------
(rule "Sensitive analog away from switch node" (condition "(A.hasNetclass('ANALOG_SENSE') || A.hasNetclass('BUCK_FEEDBACK')) && B.NetName == '/BUCK_SW'") (constraint clearance (min 0.50mm)))
(rule "No routing in ESP antenna area" (condition "A.intersectsArea('ESP_ANTENNA_RF')") (constraint disallow track via))
(rule "L2 is a reference plane" (layer "In1.Cu") (constraint disallow track))
(rule "L5 is the power plane - power feeders only" (layer "In4.Cu")
  (condition "!(A.hasNetclass('POWER_5V') || A.hasNetclass('USB_VBUS') || A.hasNetclass('POWER_5V_EXP') || A.hasNetclass('POWER_VPORT') || A.hasNetclass('POWER_3V3'))")
  (constraint disallow track))
(rule "Buck switch only on top" (layer "B.Cu") (condition "A.NetName == '/BUCK_SW'") (constraint disallow track via))
(rule "Buck switch not on inner layers" (layer inner) (condition "A.NetName == '/BUCK_SW'") (constraint disallow track via))

# Breadboard headers (Hanxia bottom access): courtyards overlap by design, pins and holes do not collide (verified by eye).
(rule "Breadboard headers courtyard overlap allowed"
  (constraint courtyard_clearance)
  (severity exclusion)
  (condition "(A.Reference == 'J17' || A.Reference == 'J18' || A.Reference == 'J19' || A.Reference == 'J20' || A.Reference == 'J22' || A.Reference == 'J23' || A.Reference == 'J31' || A.Reference == 'J32' || A.Reference == 'J33' || A.Reference == 'J34') && (B.Reference == 'J17' || B.Reference == 'J18' || B.Reference == 'J19' || B.Reference == 'J20' || B.Reference == 'J22' || B.Reference == 'J23' || B.Reference == 'J31' || B.Reference == 'J32' || B.Reference == 'J33' || B.Reference == 'J34')"))

