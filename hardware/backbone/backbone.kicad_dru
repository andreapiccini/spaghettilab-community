(version 1)
# All values in mm. Four-layer nominal FR4 stackup; USB geometry requires fab confirmation.
(rule "General routing width" (constraint track_width (min 0.12mm)))
(rule "Standard through vias" (condition "A.Type == 'Via'") (constraint via_diameter (min 0.60mm)) (constraint hole_size (min 0.30mm)))
(rule "5V backbone trunk" (condition "A.hasNetclass('POWER_5V')") (constraint track_width (min 0.25mm) (opt 1.5mm)))
(rule "3V3 and ground feeders" (condition "A.hasNetclass('POWER_3V3')") (constraint track_width (min 0.15mm) (opt 1.20mm)))
(rule "USB VBUS feed" (condition "A.hasNetclass('USB_VBUS')") (constraint track_width (min 0.25mm) (opt 1.50mm)))
(rule "Universal port conductors" (condition "A.hasNetclass('PORT_IO_POWER')") (constraint track_width (min 0.15mm) (opt 0.50mm)))
(rule "Buck switch short wide copper" (condition "A.hasNetclass('BUCK_SWITCH')") (constraint track_width (min 0.25mm) (opt 0.80mm)))
(rule "USB differential geometry - preliminary 90 ohm target" (condition "A.hasNetclass('USB_DIFF')") (constraint track_width (min 0.15mm) (opt 0.18mm) (max 0.22mm)) (constraint diff_pair_gap (min 0.12mm) (opt 0.15mm) (max 0.20mm)) (constraint diff_pair_uncoupled (max 5mm)) (constraint skew (max 0.50mm)))
(rule "USB pair internal spacing" (condition "A.hasNetclass('USB_DIFF') && AB.isCoupledDiffPair()") (constraint clearance (min 0.12mm)))
(rule "CAN conductors - co-route H and L" (condition "A.hasNetclass('CAN_BUS')") (constraint track_width (min 0.18mm) (opt 0.25mm)))
(rule "Sensitive analog away from switch node" (condition "(A.hasNetclass('ANALOG_SENSE') || A.hasNetclass('ANALOG_DAC') || A.hasNetclass('BUCK_FEEDBACK')) && B.NetName == '/BUCK_SW'") (constraint clearance (min 0.50mm)))
# RF area exists on all copper layers. No net-specific bypass exceptions.
(rule "No routing in ESP antenna area" (condition "A.intersectsArea('ESP_ANTENNA_RF')") (constraint disallow track via))

(rule "L2 is a reference plane" (layer "In1.Cu") (constraint disallow track))
(rule "USB on outer signal layers" (layer inner) (condition "A.hasNetclass('USB_DIFF')") (constraint disallow track))
(rule "Standard low-cost through-via technology" (constraint disallow micro_via blind_via buried_via))

# Local power escapes. Optimum applies only inside component courtyard; trunk remains wide.
# Escape minimums are not continuous-current ratings. Short escapes only.
(rule "Escape C5 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('C5')") (constraint track_width (min 0.15mm) (opt 0.8mm)))
(rule "Escape C85 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('C85')") (constraint track_width (min 0.15mm) (opt 0.3mm)))
(rule "Escape D6 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('D6')") (constraint track_width (min 0.15mm) (opt 0.8mm)))
(rule "Escape J10 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('J10')") (constraint track_width (min 0.15mm) (opt 0.4mm)))
(rule "Escape J11 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('J11')") (constraint track_width (min 0.15mm) (opt 0.4mm)))
(rule "Escape J2 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('J2')") (constraint track_width (min 0.15mm) (opt 0.6mm)))
(rule "Escape J9 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('J9')") (constraint track_width (min 0.15mm) (opt 0.6mm)))
(rule "Escape Q2 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('Q2')") (constraint track_width (min 0.15mm) (opt 0.4mm)))
(rule "Escape U4 5V" (condition "A.NetName == '5V' && A.intersectsCourtyard('U4')") (constraint track_width (min 0.15mm) (opt 0.6mm)))
(rule "Escape C1 VCORE" (condition "A.NetName == 'VCORE' && A.intersectsCourtyard('C1')") (constraint track_width (min 0.15mm) (opt 0.3mm)))
