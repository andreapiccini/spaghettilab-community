    "reset_pulldown": "R203 10k to GND",
    "boot_independent": true,
    "pin_mapping": {
      "1": "ESP_EN",
      "2": "GND",
      "3": "GND",
      "4": "EXP_RESET_N",
      "5": "3V3",
      "6": "ROW_ARM_N"
    },
    "logic": [
      "U60 SN74LVC1G97DBVR"
    ],
    "also_enables": "U63 EN; 3V3_ROWS current-limited supply",
    "software_reset_requirement": "Never GPIO-hold ROW_ARM_N; keep high/input for at least 3ms after EN release, then release reset only after MCU initialization. Qualify watchdog/software/brownout reset on prototype."
  },
