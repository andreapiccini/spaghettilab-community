(global_label "ESP_BOOT"(shape bidirectional)(at 260.35 71.12 270.0)(effects(font(size 1.0 1.0))(justify right))(uuid "3233fa88-f3e8-4572-8e4e-15bfbe31f66e")(property "Descrizione" "BOOT pad27: S3 GPIO0 / S31 GPIO61; separate from row enable"(at 260.350000 71.120000 0)(hide yes)(effects(font(size 0.95 0.95))(justify left))))
(text "LEGENDA COLLEGAMENTI GLOBALI\n3V3: rail regolata; 5V: rail ingresso; GND: riferimento comune.\nI2C_INT: SDA pad25, SCL pad5; I2C_USER: pad19/20 connectors; CAN_TX/RX: pad10/11.\nUSB_ESP_D+/D-: coppia USB verso ESP; USB_VBUS_PRESENT: rilevamento5VUSB.\nROW_ARM_N: pad22, high=rows OFF; EXP_RESET_N: reset expander and row power enable.\nROW_Lxx = banco A; ROW_Rxx = banco B. Suffissi spiegati nel foglio05.\nTutti i nomi sono globali; i fili mostrano la topologia. Punto = connessione, incrocio senza punto = nessun collegamento."(at 15.24 209.55 0)(effects(font(size 1.05 1.05))(justify left top))(uuid "2f7a675e-0092-4954-ba9f-089087901d2a"))
