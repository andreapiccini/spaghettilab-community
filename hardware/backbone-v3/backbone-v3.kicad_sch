(text "LEGENDA COLLEGAMENTI GLOBALI\n3V3: rail regolata; 5V: rail ingresso; GND: riferimento comune.\nI2C_INT: SDA pad25, SCL pad5; I2C_USER: pad19/20 connectors; CAN_TX/RX: pad10/11.\nUSB_ESP_D+/D-: coppia USB verso ESP; USB_VBUS_PRESENT: rilevamento5VUSB.\nROW_ARM_N: pad22, high=rows OFF; EXP_RESET_N: reset expander and row power enable.\nROW_Lxx = banco A; ROW_Rxx = banco B. Suffissi spiegati nel foglio05.\nTutti i nomi sono globali; i fili mostrano la topologia. Punto = connessione, incrocio senza punto = nessun collegamento."
		(exclude_from_sim no)
		(at 15.24 209.55 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left top)
		)
		(uuid "2f7a675e-0092-4954-ba9f-089087901d2a")
	)
(text "SPI uses the shared user bus. Disconnect I2C devices first.\n5V supply, 3.3V signals."
		(exclude_from_sim no)
		(at 268 228 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "4405b8ac-f0e6-46e3-921c-79a0ec258234")
	)
