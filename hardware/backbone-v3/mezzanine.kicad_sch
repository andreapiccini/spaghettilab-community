(text "Dual MCU revision: J26.22/.24 and J27.22 reserved NC.\nUse dual-mcu-connectors.csv for the current pinout; GPIO net names are S3 aliases."(at 25.4 320.04 0)(effects(font(size 1 1))(justify left top))(uuid "b19450dd-ffe2-4160-9b8b-b1c0bd32cbe6"))
