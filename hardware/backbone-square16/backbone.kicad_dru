# Final review 2026-11-04: design envelopes, see PRE-ROUTING-REVIEW.md.
(rule "Driver branch conductors" (condition "A.hasNetclass('DRIVER_BRANCH')") (constraint track_width (min 0.20mm) (opt 0.50mm)))
(rule "Kelvin sense only - no load current" (condition "A.hasNetclass('KELVIN_SENSE')") (constraint track_width (min 0.15mm) (opt 0.15mm)))
(rule "GPIO signal conductors" (condition "A.hasNetclass('GPIO_DIRECT') || A.hasNetclass('GATE_CTRL') || A.hasNetclass('TERM_5V')") (constraint track_width (min 0.15mm) (opt 0.20mm)))
(rule "High current rail preference on L3" (layer "In2.Cu") (condition "A.hasNetclass('POWER_5V') || A.hasNetclass('USB_VBUS')") (constraint track_width (min 0.20mm) (opt 4.0mm)))
(rule "3V3 feeder preference on L3" (layer "In2.Cu") (condition "A.hasNetclass('POWER_3V3')") (constraint track_width (min 0.15mm) (opt 3.0mm)))
(rule "Port feeders on L3" (layer "In2.Cu") (condition "A.hasNetclass('PORT_IO_POWER') || A.hasNetclass('DRIVER_BRANCH')") (constraint track_width (min 0.20mm) (opt 0.80mm)))
(rule "Buck switch only on top" (layer "B.Cu") (condition "A.NetName == '/BUCK_SW'") (constraint disallow track via))
(rule "Buck switch not on inner layers" (layer inner) (condition "A.NetName == '/BUCK_SW'") (constraint disallow track via))
(rule "Port signal fanout U12" (condition "A.hasNetclass('PORT_IO_POWER') && A.intersectsCourtyard('U12')") (constraint track_width (min 0.15mm) (opt 0.2mm)))
(rule "Port signal fanout U13" (condition "A.hasNetclass('PORT_IO_POWER') && A.intersectsCourtyard('U13')") (constraint track_width (min 0.15mm) (opt 0.2mm)))
(rule "Driver pad fanout Q3" (condition "A.hasNetclass('DRIVER_BRANCH') && A.intersectsCourtyard('Q3')") (constraint track_width (min 0.25mm) (opt 0.4mm)))
(rule "Driver pad fanout Q4" (condition "A.hasNetclass('DRIVER_BRANCH') && A.intersectsCourtyard('Q4')") (constraint track_width (min 0.25mm) (opt 0.4mm)))
(rule "Driver pad fanout Q5" (condition "A.hasNetclass('DRIVER_BRANCH') && A.intersectsCourtyard('Q5')") (constraint track_width (min 0.25mm) (opt 0.4mm)))
(rule "Driver pad fanout Q6" (condition "A.hasNetclass('DRIVER_BRANCH') && A.intersectsCourtyard('Q6')") (constraint track_width (min 0.25mm) (opt 0.4mm)))
(rule "Driver pad fanout Q7" (condition "A.hasNetclass('DRIVER_BRANCH') && A.intersectsCourtyard('Q7')") (constraint track_width (min 0.25mm) (opt 0.4mm)))
(rule "Driver pad fanout Q8" (condition "A.hasNetclass('DRIVER_BRANCH') && A.intersectsCourtyard('Q8')") (constraint track_width (min 0.25mm) (opt 0.4mm)))
(rule "Pad fanout J10.1" (condition "A.NetName == '5V' && A.intersectsArea('FANOUT_J10_1')") (constraint track_width (min 0.2mm) (opt 0.4mm)))
(rule "Pad fanout J10.2" (condition "A.NetName == '5V' && A.intersectsArea('FANOUT_J10_2')") (constraint track_width (min 0.2mm) (opt 0.4mm)))
(rule "Pad fanout J10.3" (condition "A.NetName == 'VCORE' && A.intersectsArea('FANOUT_J10_3')") (constraint track_width (min 0.2mm) (opt 0.4mm)))
(rule "Pad fanout J10.4" (condition "A.NetName == 'VCORE' && A.intersectsArea('FANOUT_J10_4')") (constraint track_width (min 0.2mm) (opt 0.4mm)))
