	int "Maximum copied log chunk bytes"
	range 64 512
	default 256
	help
	  Fixed size of each log copy. Longer backend fragments are truncated.

config SPAGHETTI_REMOTE_CONSOLE_LOG_QUEUE_DEPTH
	int "Remote-console log queue depth"
	range 2 32
	default 8
	help
	  Number of static log chunks. The oldest chunk is dropped when full.

config SPAGHETTI_REMOTE_CONSOLE_POLL_MS
	int "Remote-console poll period in milliseconds"
	range 10 1000
	default 100
	help
	  Maximum delay for socket events and queued log forwarding.

