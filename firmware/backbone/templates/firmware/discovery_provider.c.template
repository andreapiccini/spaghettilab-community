/**
 * @file
 * @brief Example Discovery provider registered via iterable section.
 *
 * Copy to subsys/discovery/providers/<name>.c. Do not edit discovery.c to
 * register the provider.
 */

#include <errno.h>
#include <string.h>

#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>

#include <spaghetti/discovery.h>
#include <spaghetti/port.h>
#include <spaghetti/power.h>
#include <spaghetti/topology.h>

LOG_MODULE_REGISTER(spaghetti_example_discovery,
		    CONFIG_SPAGHETTI_EXAMPLE_DISCOVERY_LOG_LEVEL);

static int example_discovery_scan(const struct spaghetti_port *port,
				  spaghetti_discovery_emit_candidate_cb_t emit,
				  void *emit_user_data,
				  k_timeout_t timeout)
{
	struct spaghetti_discovery_candidate candidate;
	static const uint8_t identity[] = {0x01U, 0x02U};

	ARG_UNUSED(timeout);

	if ((port == NULL) || (emit == NULL)) {
		return -EINVAL;
	}

	/*
	 * Perform only bounded Port I/O here. Emit zero or more candidates;
	 * Discovery copies them. Do not apply Config or create Modules.
	 */
	memset(&candidate, 0, sizeof(candidate));
	candidate.bay_id = SPAGHETTI_BAY_ID_UNSPECIFIED;
	candidate.power_rail_id = SPAGHETTI_POWER_RAIL_UNSPECIFIED;
	candidate.identity_size = sizeof(identity);
	memcpy(candidate.identity, identity, sizeof(identity));
	strncpy(candidate.suggested_type_id, "example",
		sizeof(candidate.suggested_type_id) - 1U);

	return emit(&candidate, emit_user_data);
}

static const struct spaghetti_discovery_provider_ops example_discovery_ops = {
	.scan = example_discovery_scan,
};

SPAGHETTI_DISCOVERY_PROVIDER_DEFINE(spaghetti_example_discovery_provider) = {
	.provider_id = "example.i2c_register",
	.api_version = SPAGHETTI_DISCOVERY_PROVIDER_API_VERSION,
	.method = SPAGHETTI_DISCOVERY_METHOD_I2C_REGISTER,
	.confidence = SPAGHETTI_DISCOVERY_HEURISTIC,
	.probe_flags = SPAGHETTI_DISCOVERY_PROBE_READ_ONLY,
	.required_capabilities = SPAGHETTI_PORT_CAP_I2C,
	.ops = &example_discovery_ops,
};
