# Copy this file to .env only if you need to override a default.
ZEPHYR_VERSION=v4.4.0
ZEPHYR_DOCKER_TAG=v0.29.2
BOARD=spaghettilab_core_v1/esp32c3

# Optional persistent host serial-port override.
# Usually make flash and make screen detect it without this setting.
# Examples: /dev/ttyACM0, /dev/cu.usbserial-110, or COM3.
# PORT=/dev/ttyACM0
