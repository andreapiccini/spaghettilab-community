@dataclass(frozen=True)
class Finding:
    code: str
    path: Path
    line: int
    detail: str

    @property
    def rule(self) -> Rule:
        return RULES[self.code]


@dataclass
class CScan:
    sanitized_lines: list[str]
    line_comment_columns: list[int | None]


def is_roadmap_task_candidate(path: Path) -> bool:
    try:
        path.resolve().relative_to(ROADMAP_ROOT)
    except ValueError:
        return False
    return path.suffix.lower() == ".md" and path.name.upper().startswith("TASK")


def is_supported(path: Path) -> bool:
    return (
        path.name in SUPPORTED_NAMES
        or path.suffix.lower() in SUPPORTED_SUFFIXES
        or is_roadmap_task_candidate(path)
    )


def is_excluded(path: Path) -> bool:
    try:
        relative = path.resolve().relative_to(PROJECT_ROOT)
    except ValueError:
        return True
    return any(part in EXCLUDED_DIRS or part.startswith("build-") for part in relative.parts)


def split_cmake_arguments(body: str) -> list[str]:
    without_comments = re.sub(r"(?m)#.*$", "", body)
    return shlex.split(without_comments, comments=False, posix=True)


def cmake_calls(text: str) -> list[tuple[str, str]]:
    calls: list[tuple[str, str]] = []
    call_start = re.compile(r"(?im)^\s*([a-z_][a-z0-9_]*)\s*\(")
    offset = 0

    while match := call_start.search(text, offset):
        depth = 1
        index = match.end()
        in_quote = False
        escaped = False
        while index < len(text) and depth > 0:
            character = text[index]
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == '"':
                in_quote = not in_quote
            elif not in_quote and character == "(":
                depth += 1
            elif not in_quote and character == ")":
                depth -= 1
            index += 1
        if depth != 0:
            raise ValueError(f"unterminated CMake call: {match.group(1)}")
        calls.append((match.group(1).lower(), text[match.end() : index - 1]))
        offset = index

    return calls


def resolve_cmake_path(value: str) -> Path | None:
    if not value or value.startswith("$") or "$<" in value:
        return None
    expanded = value.replace("${CMAKE_CURRENT_SOURCE_DIR}", str(PROJECT_ROOT))
    path = Path(expanded)
    if not path.is_absolute():
        path = PROJECT_ROOT / path
    return path.resolve()


def declared_cmake_scope() -> tuple[list[Path], list[Path]]:
    cmake_path = PROJECT_ROOT / "CMakeLists.txt"
    try:
        text = cmake_path.read_text(encoding="utf-8")
    except OSError as error:
        raise ValueError(f"cannot read CMakeLists.txt: {error}") from error

    sources: list[Path] = []
    include_dirs: list[Path] = []
    visibility = {"PRIVATE", "PUBLIC", "INTERFACE"}

    for command, body in cmake_calls(text):
        arguments = split_cmake_arguments(body)
        if command == "target_sources" and arguments and arguments[0] == "app":
            values = arguments[1:]
        elif (
            command in {"target_sources_ifdef", "target_sources_ifndef"}
            and len(arguments) > 1
            and arguments[1] == "app"
        ):
            values = arguments[2:]
        elif (
            command == "target_include_directories"
            and arguments
            and arguments[0] == "app"
        ):
            for value in arguments[1:]:
                if value in visibility:
                    continue
                path = resolve_cmake_path(value)
                if path is not None and path.is_dir() and not is_excluded(path):
                    include_dirs.append(path)
            continue
        else:
            continue

        for value in values:
            if value in visibility:
                continue
            path = resolve_cmake_path(value)
            if path is not None and path.is_file() and not is_excluded(path):
                sources.append(path)

    if not sources:
        raise ValueError("CMakeLists.txt declares no source files for target 'app'")
    return sources, include_dirs


def local_include_graph(sources: Sequence[Path], include_dirs: Sequence[Path]) -> list[Path]:
    include_pattern = re.compile(r'^\s*#\s*include\s*([<"])([^>"]+)[>"]', re.MULTILINE)
    queue = list(sources)
    found: set[Path] = set()
    search_roots = [PROJECT_ROOT / "include", PROJECT_ROOT, *include_dirs]

    while queue:
        path = queue.pop()
        path = path.resolve()
        if path in found or is_excluded(path) or not path.is_file():
            continue
        found.add(path)
        if path.suffix.lower() not in C_SUFFIXES:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        for match in include_pattern.finditer(text):
            delimiter, include_name = match.groups()
            candidates = []
            if delimiter == '"':
                candidates.append(path.parent / include_name)
            candidates.extend(root / include_name for root in search_roots)
            for candidate in candidates:
                resolved = candidate.resolve()
                if resolved.is_file() and not is_excluded(resolved):
                    queue.append(resolved)
                    break

    return sorted(path for path in found if is_supported(path))


def decode_cmake_list(value: str, directories: bool = False) -> list[Path]:
    paths: list[Path] = []
    for item in value.split("|"):
        path = resolve_cmake_path(item)
        if path is None:
            continue
        correct_kind = path.is_dir() if directories else path.is_file()
        if correct_kind and not is_excluded(path):
            paths.append(path)
    return paths


def default_files() -> list[Path]:
    sources, include_dirs = declared_cmake_scope()
    return local_include_graph(sources, include_dirs)


def explicit_files(values: Sequence[str]) -> list[Path]:
    candidates: list[Path] = []
    for value in values:
        if Path(value).is_absolute():
            path = Path(value).resolve()
        else:
            path = (PROJECT_ROOT / value).resolve()
        if not path.exists():
            raise ValueError(f"path does not exist: {value}")
        if path.is_dir():
            candidates.extend(item for item in path.rglob("*") if item.is_file())
        else:
            candidates.append(path)
    return sorted({path for path in candidates if is_supported(path) and not is_excluded(path)})


def display_path(path: Path) -> str:
    try:
        return path.relative_to(PROJECT_ROOT).as_posix()
    except ValueError:
        return path.as_posix()


def add(findings: list[Finding], code: str, path: Path, line: int, detail: str) -> None:
    findings.append(Finding(code=code, path=path, line=max(line, 1), detail=detail))


def decode_file(path: Path, findings: list[Finding]) -> tuple[str, list[str]] | None:
    raw = path.read_bytes()
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        add(findings, "TEXT001", path, 1, f"UTF-8 decoding failed at byte {error.start}")
        return None

    if b"\r\n" in raw or b"\r" in raw:
        add(findings, "TEXT002", path, 1, "CR or CRLF line ending detected")

    return text, text.splitlines(keepends=True)


def visible_columns(line: str) -> int:
    return len(line.rstrip("\r\n").expandtabs(8))


def validate_common(path: Path, text: str, lines: Sequence[str], findings: list[Finding]) -> None:
    for line_number, line in enumerate(lines, start=1):
        content = line.rstrip("\r\n")
        if content.endswith((" ", "\t")):
            add(findings, "FMT001", path, line_number, "line ends with whitespace")
        columns = visible_columns(line)
        if columns > 100:
            add(findings, "FMT003", path, line_number, f"line has {columns} columns")

    if text and not text.endswith("\n"):
        add(findings, "FMT002", path, len(lines), "file does not end with LF")

    blank_run = 0
    for line_number, line in enumerate(lines, start=1):
        if line.strip():
            blank_run = 0
            continue
        blank_run += 1
        if blank_run >= 2:
            add(findings, "FMT004", path, line_number, "more than one consecutive blank line")


def scan_c_lexical(lines: Sequence[str]) -> CScan:
    sanitized_lines: list[str] = []
    line_comments: list[int | None] = []
    in_block_comment = False

    for raw_line in lines:
        line = raw_line.rstrip("\r\n")
        output = list(line)
        line_comment_column: int | None = None
        quote: str | None = None
        index = 0
        while index < len(line):
            char = line[index]
            next_char = line[index + 1] if index + 1 < len(line) else ""

            if in_block_comment:
                output[index] = " "
                if char == "*" and next_char == "/":
                    output[index + 1] = " "
                    in_block_comment = False
                    index += 2
                    continue
                index += 1
                continue

            if quote is not None:
                output[index] = " "
                if char == "\\" and index + 1 < len(line):
                    output[index + 1] = " "
                    index += 2
                    continue
                if char == quote:
                    quote = None
                index += 1
                continue

            if char in ('"', "'"):
                quote = char
                output[index] = " "
                index += 1
                continue

            if char == "/" and next_char == "*":
                output[index] = " "
                output[index + 1] = " "
                in_block_comment = True
                index += 2
                continue

            if char == "/" and next_char == "/":
                line_comment_column = index
                for remainder in range(index, len(line)):
                    output[remainder] = " "
                break

            index += 1

        sanitized_lines.append("".join(output))
        line_comments.append(line_comment_column)

    return CScan(sanitized_lines=sanitized_lines, line_comment_columns=line_comments)


def line_for_offset(text: str, offset: int) -> int:
    return text.count("\n", 0, offset) + 1


def previous_doxygen(text: str, offset: int) -> str | None:
    prefix = text[:offset].rstrip()
    if not prefix.endswith("*/"):
        return None
    start = prefix.rfind("/**")
    if start < 0:
        return None
    return prefix[start:]


def parameter_names(parameters: str) -> list[str]:
    compact = " ".join(parameters.replace("\n", " ").split())
    if not compact or compact == "void":
        return []
    names: list[str] = []
    for parameter in compact.split(","):
        parameter = parameter.strip()
        if "(*" in parameter:
            match = re.search(r"\(\s*\*\s*([A-Za-z_]\w*)", parameter)
        else:
            match = re.search(r"([A-Za-z_]\w*)\s*(?:\[[^]]*\])?\s*$", parameter)
        if match:
            names.append(match.group(1))
    return names


FUNCTION_PATTERN = re.compile(
    r"(?ms)^[ \t]*(?!typedef\b)(?!static\b)"
    r"(?P<return>(?:const\s+)?(?:(?:struct|enum)\s+)?[A-Za-z_]\w*(?:\s*\*)?)"
    r"[ \t]+(?P<name>[A-Za-z_]\w*)[ \t]*\((?P<params>[^;{}]*)\)[ \t]*;"
)


def validate_public_header(
    path: Path, text: str, sanitized_text: str, findings: list[Finding]
) -> None:
    if not text.strip():
        return

    guard_match = re.search(r"(?m)^#ifndef\s+(SPAGHETTI_[A-Z0-9_]+_H)\s*$", text)
    if not guard_match or not re.search(
        rf"(?m)^#define\s+{re.escape(guard_match.group(1))}\s*$" if guard_match else r"(?!)",
        text,
    ):
        add(findings, "HDR001", path, 1, "matching SPAGHETTI_*_H guard not found")

    if not re.search(r"/\*\*.*?@file.*?\*/", text, re.DOTALL):
        add(
            findings,
            "HDR002",
            path,
            1,
            "public header must start its API documentation with @file",
        )

    for match in FUNCTION_PATTERN.finditer(sanitized_text):
        name = match.group("name")
        if name.startswith(("if", "for", "while", "switch")):
            continue
        line = line_for_offset(sanitized_text, match.start())
        comment = previous_doxygen(text, match.start())
        if comment is None:
            add(findings, "HDR003", path, line, f"{name} has no adjacent /** ... */ contract")
            continue

        for parameter in parameter_names(match.group("params")):
            if not re.search(rf"@param(?:\[[^]]+\])?\s+{re.escape(parameter)}\b", comment):
                add(
                    findings,
                    "HDR004",
                    path,
                    line,
                    f"parameter '{parameter}' of {name} is undocumented",
                )

        return_type = " ".join(match.group("return").split())
        if return_type == "void":
            pass
        elif return_type == "int":
            if "@retval 0" not in comment or not re.search(r"@retval\s+-E[A-Z0-9_]+", comment):
                add(
                    findings,
                    "HDR005",
                    path,
                    line,
                    f"{name} must document success and expected errno values",
                )
        elif "@return" not in comment:
            add(
                findings,
                "HDR005",
                path,
                line,
                f"{name} must document its infallible return value with @return",
            )

        if not name.startswith("spaghetti_"):
            add(
                findings,
                "C012",
                path,
                line,
                f"external declaration '{name}' is not project-qualified",
            )

    type_pattern = re.compile(
        r"(?ms)^[ \t]*(?P<kind>enum|struct)\s+"
        r"(spaghetti_\w+)\s*\{(?P<body>.*?)\};"
    )
    for match in type_pattern.finditer(sanitized_text):
        line = line_for_offset(sanitized_text, match.start())
        if previous_doxygen(text, match.start()) is None:
            add(
                findings,
                "HDR006",
                path,
                line,
                f"public {match.group('kind')} {match.group(2)} has no type comment",
            )
        body_start_line = line_for_offset(sanitized_text, match.start("body"))
        for offset, raw_line in enumerate(match.group("body").splitlines()):
            stripped = raw_line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if stripped.endswith(",") or re.match(r"^[A-Za-z_]\w*\s*(?:=|;|\[)", stripped):
                source_line_number = body_start_line + offset
                source_line = text.splitlines()[source_line_number - 1]
                if "/**<" not in source_line:
                    add(
                        findings,
                        "HDR006",
                        path,
                        source_line_number,
                        "public enum value or struct field needs a /**< ... */ comment",
                    )


def parenthesis_depth_before(lines: Sequence[str]) -> list[int]:
    depths: list[int] = []
    depth = 0
    for line in lines:
        depths.append(depth)
        depth += line.count("(") - line.count(")")
        depth = max(depth, 0)
    return depths


def validate_c_file(path: Path, text: str, lines: Sequence[str], findings: list[Finding]) -> None:
    scan = scan_c_lexical(lines)
    sanitized_text = "\n".join(scan.sanitized_lines)
    depths = parenthesis_depth_before(scan.sanitized_lines)

    for line_number, column in enumerate(scan.line_comment_columns, start=1):
        if column is not None:
            add(findings, "C003", path, line_number, f"// comment begins at column {column + 1}")

    for line_number, (raw_line, sanitized) in enumerate(
        zip(lines, scan.sanitized_lines), start=1
    ):
        raw = raw_line.rstrip("\r\n")
        stripped = raw.lstrip()
        if (
            raw.startswith(" ")
            and stripped
            and not stripped.startswith(("*", "/*", "*/", "#"))
            and depths[line_number - 1] == 0
        ):
            add(findings, "C001", path, line_number, "first indentation character is a space")
        if re.search(r"\S\t", raw):
            add(findings, "C002", path, line_number, "tab appears after non-whitespace content")

        code = sanitized.strip()
        if re.search(r"\buint\b", code):
            add(
                findings,
                "C005",
                path,
                line_number,
                "plain uint is not an explicit-width project type",
            )
        if re.search(r"\b(?:strcpy|strcat|sprintf)\s*\(", code) or re.search(
            r"\bscanf\s*\(\s*\"%s", raw
        ):
            add(findings, "C006", path, line_number, "unbounded string operation detected")
        if re.search(r"\b(?:k_malloc|k_calloc|k_realloc|malloc|calloc|realloc)\s*\(", code):
            add(
                findings,
                "C009",
                path,
                line_number,
                "allocation requires an owner, bound, and failure policy",
            )
        if re.search(r"\bprintk\s*\(", code):
            add(
                findings,
                "C010",
                path,
                line_number,
                "use LOG_* outside the explicit bootstrap baseline",
            )
        if re.search(r"^\s*extern\s+(?!const\b).+\b[A-Za-z_]\w*\s*(?:\[[^]]*\])?\s*;", sanitized):
            add(findings, "C008", path, line_number, "extern object is mutable")

        define = re.match(r"^\s*#define\s+([A-Za-z_]\w*)", sanitized)
        if define:
            name = define.group(1)
            allowed = (
                name.startswith("SPAGHETTI_")
                or name.startswith("CONFIG_")
                or name in {"DT_DRV_COMPAT", "LOG_LEVEL", "_POSIX_C_SOURCE"}
            )
            if not allowed:
                add(
                    findings,
                    "C011",
                    path,
                    line_number,
                    f"macro '{name}' lacks project/component prefix",
                )

    if path.suffix.lower() in {".c", ".cpp"} and "/**" in text:
        for match in re.finditer(r"/\*\*", text):
            add(
                findings,
                "C007",
                path,
                line_for_offset(text, match.start()),
                "Doxygen belongs in the public header",
            )

    unspecified_parameters = re.compile(
        r"(?m)^[ \t]*(?:static[ \t]+)?(?:const[ \t]+)?"
        r"(?:(?:struct|enum)[ \t]+[A-Za-z_]\w*|[A-Za-z_]\w*)"
        r"(?:[ \t]*\*)?[ \t]+([a-z_]\w*)[ \t]*\([ \t]*\)[ \t]*(?:;|\{)"
    )
    for match in unspecified_parameters.finditer(sanitized_text):
        add(
            findings,
            "C004",
            path,
            line_for_offset(sanitized_text, match.start()),
            f"'{match.group(1)}()' does not declare an explicit parameter list",
        )

    if path.suffix.lower() in {".c", ".cpp"}:
        definition_pattern = re.compile(
            r"(?m)^[ \t]*(?!static\b)(?!typedef\b)"
            r"(?:[A-Za-z_]\w*[ \t]+)+(?:\*[ \t]*)?(?P<name>[A-Za-z_]\w*)[ \t]*\([^;]*\)[ \t]*\{"
        )
        for match in definition_pattern.finditer(sanitized_text):
            name = match.group("name")
            if name != "main" and not name.startswith("spaghetti_"):
                add(
                    findings,
                    "C012",
                    path,
                    line_for_offset(sanitized_text, match.start()),
                    f"external definition '{name}' is not project-qualified",
                )

    uses_logging = bool(re.search(r"\bLOG_(?:ERR|WRN|INF|DBG|HEXDUMP|INSTANCE)", sanitized_text))
    has_module = "LOG_MODULE_REGISTER" in sanitized_text or "LOG_MODULE_DECLARE" in sanitized_text
    if uses_logging and not has_module:
        line = line_for_offset(sanitized_text, re.search(r"\bLOG_", sanitized_text).start())
        add(
            findings,
            "LOG001",
            path,
            line,
            "LOG_* call has no module registration/declaration in this file",
        )

    if path.suffix.lower() == ".h" and path.is_relative_to(PUBLIC_HEADER_ROOT):
        validate_public_header(path, text, sanitized_text, findings)


def validate_filename(path: Path, findings: list[Finding]) -> None:
    if path.suffix.lower() not in C_SUFFIXES:
        return
    stem = path.stem
    if not re.fullmatch(r"[a-z][a-z0-9]*(?:_[a-z0-9]+)*", stem):
        add(findings, "FILE001", path, 1, f"'{path.name}' is not lowercase snake_case")


def validate_prj_conf(path: Path, lines: Sequence[str], findings: list[Finding]) -> None:
    if path.name != "prj.conf":
        return
    for line_number, line in enumerate(lines, start=1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if not re.fullmatch(r"CONFIG_[A-Z0-9_]+=(?:y|n|m|.+)", stripped):
            add(findings, "CFG001", path, line_number, f"invalid assignment: {stripped}")


def validate_cmake(path: Path, lines: Sequence[str], findings: list[Finding]) -> None:
    if path.name != "CMakeLists.txt" and path.suffix.lower() != ".cmake":
        return
    for line_number, line in enumerate(lines, start=1):
        content = line.rstrip("\r\n")
        if not content.strip() or content.lstrip().startswith("#"):
            continue
        prefix = content[: len(content) - len(content.lstrip())]
        if "\t" in prefix or len(prefix) % 2 != 0:
            add(
                findings,
                "CMAKE001",
                path,
                line_number,
                "indentation is not a multiple of two spaces",
            )
        command = re.match(r"^\s*([A-Za-z_]\w*)(\s*)\(", content)
        if command and (command.group(1) != command.group(1).lower() or command.group(2)):
            add(
                findings,
                "CMAKE002",
                path,
                line_number,
                f"command is written as '{command.group(1)}{command.group(2)}('",
            )


def validate_kconfig(path: Path, lines: Sequence[str], findings: list[Finding]) -> None:
    if path.name != "Kconfig":
        return
    for line_number, line in enumerate(lines, start=1):
        content = line.rstrip("\r\n")
        if not content.strip():
            continue
        if content.startswith(" "):
            add(findings, "KCFG001", path, line_number, "indented line starts with spaces")
        if re.match(r"^\s*#[^\s#]", content):
            add(findings, "KCFG002", path, line_number, "comment has no space after #")


def validate_devicetree(path: Path, lines: Sequence[str], findings: list[Finding]) -> None:
    if path.suffix.lower() not in {".dts", ".dtsi", ".overlay"}:
        return
    for line_number, line in enumerate(lines, start=1):
        content = line.rstrip("\r\n")
        stripped = content.lstrip()
        if not stripped or stripped.startswith(("/*", "*", "*/", "#include")):
            continue
        if content.startswith(" "):
            add(findings, "DTS001", path, line_number, "block indentation starts with spaces")
        property_match = re.match(r"^\s*([A-Za-z0-9,#_-]+)\s*=", content)
        if property_match and "_" in property_match.group(1):
            add(
                findings,
                "DTS002",
                path,
                line_number,
                f"property '{property_match.group(1)}' contains an underscore",
            )


def validate_yaml(path: Path, lines: Sequence[str], findings: list[Finding]) -> None:
    if path.suffix.lower() not in {".yaml", ".yml"}:
        return
    for line_number, line in enumerate(lines, start=1):
        if "\t" in line:
            add(findings, "YAML001", path, line_number, "tab character detected")


def validate_roadmap_task(
    path: Path, text: str, lines: Sequence[str], findings: list[Finding]
) -> None:
    try:
        relative = path.resolve().relative_to(ROADMAP_ROOT)
    except ValueError:
        add(findings, "TASK001", path, 1, "task is outside the roadmap directory")
        return

    phase_pattern = re.compile(r"^(?P<phase>\d{3})-[a-z0-9]+(?:-[a-z0-9]+)*$")
    file_pattern = re.compile(
        r"^TASK-(?P<phase>\d{3})-(?P<task>\d{2})-"
        r"[a-z0-9]+(?:-[a-z0-9]+)*\.md$"
    )
    phase_match = phase_pattern.fullmatch(relative.parent.name)
    file_match = file_pattern.fullmatch(relative.name)
    canonical_location = len(relative.parts) == 2 and phase_match and file_match

    if not canonical_location:
        add(
            findings,
            "TASK001",
            path,
            1,
            f"non-canonical roadmap task path: roadmap/{relative.as_posix()}",
        )
    elif phase_match.group("phase") != file_match.group("phase"):
        add(
            findings,
            "TASK001",
            path,
            1,
            "task filename phase does not match its parent phase directory",
        )

    expected_phase = file_match.group("phase") if file_match else None
    expected_task = file_match.group("task") if file_match else None
    title_match = re.search(r"(?m)^# TASK-(\d{3})-(\d{2})\s+—\s+.+$", text)
    phase_line_match = re.search(
        r"(?m)^\*\*(?:Phase|Fase):\*\*\s+(\d{3})\s+—\s+.+$", text
    )

    if (
        expected_phase is None
        or expected_task is None
        or title_match is None
        or phase_line_match is None
        or title_match.group(1) != expected_phase
        or title_match.group(2) != expected_task
        or phase_line_match.group(1) != expected_phase
    ):
        add(
            findings,
            "TASK001",
            path,
            1,
            "filename, H1 task ID, and phase metadata are not identical",
        )

    status_match = re.search(
        r"(?m)^\*\*(?:Status|Stato):\*\*\s+"
        r"(⬜ TODO|🟨 IN PROGRESS|✅ DONE|⛔ BLOCKED)\s*$",
        text,
    )
    if status_match is None:
        add(
            findings,
            "TASK001",
            path,
            1,
            "missing or invalid task status metadata",
        )
        return

    checklist_start = next(
        (
            index
            for index, line in enumerate(lines)
            if line.strip() in {"## Completion checklist", "## Checklist di completamento"}
        ),
        None,
    )
    if checklist_start is None:
        add(findings, "TASK001", path, 1, "missing task completion checklist section")
        return

    boxes: list[bool] = []
    for line in lines[checklist_start + 1 :]:
        if line.startswith("## "):
            break
        checkbox = re.match(r"^\s*-\s+\[([ xX])\]\s+", line)
        if checkbox:
            boxes.append(checkbox.group(1).lower() == "x")

    if not boxes:
        add(findings, "TASK001", path, checklist_start + 1, "completion checklist is empty")
        return

    actual_status = status_match.group(1)
    if actual_status == "⛔ BLOCKED":
        return
    if all(boxes):
        expected_status = "✅ DONE"
    elif any(boxes):
        expected_status = "🟨 IN PROGRESS"
    else:
        expected_status = "⬜ TODO"

    if actual_status != expected_status:
        add(
            findings,
            "TASK002",
            path,
            line_for_offset(text, status_match.start()),
            f"status is '{actual_status}', checklist requires '{expected_status}'",
        )


def validate_log_modules(
    files: Sequence[Path],
    decoded: dict[Path, str],
    findings: list[Finding],
    require_registration: bool,
) -> None:
    registrations: dict[str, list[tuple[Path, int, str | None]]] = {}
    declarations: dict[str, list[tuple[Path, int]]] = {}
    register_pattern = re.compile(
        r"LOG_MODULE_REGISTER\s*\(\s*([A-Za-z_]\w*)\s*(?:,\s*([A-Za-z_]\w*))?\s*\)"
    )
    declare_pattern = re.compile(r"LOG_MODULE_DECLARE\s*\(\s*([A-Za-z_]\w*)")

    for path in files:
        if path.suffix.lower() not in {".c", ".cpp"} or path not in decoded:
            continue
        text = decoded[path]
        for match in register_pattern.finditer(text):
            registrations.setdefault(match.group(1), []).append(
                (path, line_for_offset(text, match.start()), match.group(2))
            )
        for match in declare_pattern.finditer(text):
            declarations.setdefault(match.group(1), []).append(
                (path, line_for_offset(text, match.start()))
            )

    for module, locations in registrations.items():
        if len(locations) > 1:
            for path, line, _level in locations:
                add(
                    findings,
                    "LOG003",
                    path,
                    line,
                    f"module '{module}' has {len(locations)} registrations",
                )
        for path, line, level in locations:
            if level is None or not level.startswith("CONFIG_SPAGHETTI_"):
                add(
                    findings,
                    "LOG002",
                    path,
                    line,
                    f"module '{module}' level is '{level or 'default'}'",
                )

    for module, locations in declarations.items():
        if require_registration and module not in registrations:
            for path, line in locations:
                add(
                    findings,
                    "LOG004",
                    path,
                    line,
                    f"module '{module}' is declared but never registered",
                )


def validate(
    paths: Sequence[Path], require_complete_scope: bool
) -> tuple[list[Finding], int, int]:
    findings: list[Finding] = []
    decoded: dict[Path, str] = {}
    checked_files = 0
    empty_files = 0

    for path in paths:
        result = decode_file(path, findings)
        if result is None:
            continue
        text, lines = result
        decoded[path] = text

        if is_roadmap_task_candidate(path):
            checked_files += 1
            validate_roadmap_task(path, text, lines, findings)
            continue

        if not text.strip():
            empty_files += 1
            continue

        checked_files += 1
        validate_common(path, text, lines, findings)
        validate_filename(path, findings)
        validate_prj_conf(path, lines, findings)
        validate_cmake(path, lines, findings)
        validate_kconfig(path, lines, findings)
        validate_devicetree(path, lines, findings)
        validate_yaml(path, lines, findings)
        if path.suffix.lower() in C_SUFFIXES:
            validate_c_file(path, text, lines, findings)

    validate_log_modules(paths, decoded, findings, require_complete_scope)
    findings.sort(key=lambda finding: (display_path(finding.path), finding.line, finding.code))
    return findings, checked_files, empty_files


def supports_color(disabled: bool) -> bool:
    return not disabled and "NO_COLOR" not in os.environ and sys.stdout.isatty()


def color(text: str, code: str, enabled: bool) -> str:
    return f"\033[{code}m{text}\033[0m" if enabled else text


def effective_severity(finding: Finding, strict: bool) -> str:
    if strict and finding.rule.default_severity == "warning":
        return "error"
    return finding.rule.default_severity


def print_findings(findings: Sequence[Finding], strict: bool, use_color: bool) -> tuple[int, int]:
    errors = 0
    warnings = 0
    for finding in findings:
        severity = effective_severity(finding, strict)
        if severity == "error":
            errors += 1
            label = color("ERROR", "31;1", use_color)
        else:
            warnings += 1
            label = color("WARNING", "38;5;208;1", use_color)
        location = f"{display_path(finding.path)}:{finding.line}"
        print(f"{label} [{finding.code}] {location} — {finding.rule.title}")
        print(f"  Found: {finding.detail}")
        print(f"  Fix:   {finding.rule.correction}")
        print(f"  Guide: FIRMWARE_IMPLEMENTATION_GUIDE.md — {finding.rule.guide_section}")
    return errors, warnings


def print_rule_list() -> None:
    for code in sorted(RULES):
        rule = RULES[code]
        print(f"{rule.code} [{rule.default_severity}] {rule.title}")
        print(f"  Fix: {rule.correction}")
        print(f"  Guide: {rule.guide_section}")


def parse_arguments(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate Spaghetti LAB firmware writing conventions before compilation."
    )
    parser.add_argument(
        "paths",
        nargs="*",
        help="files/directories to validate; defaults to target app sources from CMake",
    )
    parser.add_argument(
        "--cmake-sources",
        metavar="LIST",
        help="pipe-separated source list evaluated by CMake for target app",
    )
    parser.add_argument(
        "--cmake-includes",
        metavar="LIST",
        default="",
        help="pipe-separated include directories evaluated by CMake for target app",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="return exit code 1 when any convention finding is reported",
    )
    parser.add_argument(
        "--quiet",
        action="store_true",
        help="run every check without printing convention findings or a summary",
    )
    parser.add_argument("--no-color", action="store_true", help="disable ANSI colors")
    parser.add_argument(
        "--list-rules",
        action="store_true",
        help="print every validator rule and exit",
    )
    parser.add_argument("--version", action="version", version=f"validator {VERSION}")
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_arguments(argv if argv is not None else sys.argv[1:])
    if args.list_rules:
        print_rule_list()
        return 0

    environment_quiet = os.environ.get("SPAGHETTI_VALIDATOR_QUIET") == "1"
    quiet = args.quiet or environment_quiet

    try:
        if args.paths and args.cmake_sources is not None:
            raise ValueError("explicit paths and --cmake-sources cannot be combined")
        if args.cmake_sources is not None:
            sources = decode_cmake_list(args.cmake_sources)
            include_dirs = decode_cmake_list(args.cmake_includes, directories=True)
            if not sources:
                raise ValueError("CMake provided no existing source files for target 'app'")
            paths = local_include_graph(sources, include_dirs)
        else:
            paths = explicit_files(args.paths) if args.paths else default_files()
    except ValueError as error:
        print(f"validator: {error}", file=sys.stderr)
        return 2

    if not quiet:
        print(f"Spaghetti LAB validator {VERSION}")
        print(f"Scope: {len(paths)} candidate files")

    findings, checked_files, empty_files = validate(
        paths, require_complete_scope=not bool(args.paths)
    )
    if quiet:
        errors = sum(
            effective_severity(finding, args.strict) == "error" for finding in findings
        )
        warnings = len(findings) - errors
    else:
        errors, warnings = print_findings(
            findings, args.strict, supports_color(args.no_color)
        )

    if not quiet:
        print()
        print(
            f"Summary: checked={checked_files}, empty-skipped={empty_files}, "
            f"errors={errors}, warnings={warnings}"
        )

    if args.strict and findings:
        if not quiet:
            print("Result: FAILED (strict mode) — convention findings require review.")
        return 1

    if not quiet:
        if findings:
            print("Result: REPORTED — findings do not block the build.")
        else:
            print("Result: PASSED — source conventions are satisfied.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
