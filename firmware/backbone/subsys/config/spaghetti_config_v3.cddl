spaghetti-config-v3 = {
  0: 4,
  1: [* module],
  2: [* schedule],
  3: [* rule],
  4: mqtt,
  5: uint,             ; connectivity policy
  6: energy-policy,
  7: [* block],
  8: [* edge]
}
module = {
  0: uint,             ; stable Module key
  1: uint,             ; Port ID, quindi Flow
  2: tstr,             ; driver type ID
  3: properties,
  4: uint / nil,       ; optional Function Bay ID
  5: uint / nil        ; optional power rail ID
}
schedule = { 0: uint, 1: uint, 2: bool }
rule = { 0: uint, 1: tstr, 2: properties }
block = {
  0: uint,             ; stable block key
  1: tstr,             ; block type ID
  2: uint,             ; min algorithm version
  3: uint,             ; exact version (0 = any >= min)
  4: properties
}
edge = {
  0: uint,             ; source module/block key
  1: uint,             ; source field_id or output port
  2: uint,             ; target block key
  3: uint,             ; target input port
  4: uint              ; source kind (0=module, 1=block)
}
properties = { * uint => (bool / int / uint / tstr / bstr) }
mqtt = {
  0: bool,
  1: tstr .size (0..63),
  2: 0..65535,
  3: tstr .size (0..95)
}
energy-policy = { 0: uint, 1: uint, 2: uint }
